# Description: Core agent axioms, OS/VCS environment, operating role posture, architecture/testing invariants, and role-gated editing rules
let lang=English
let chat_lang=the language the user writes in
let chat_date_fmt=DD/MM/YYYY

rule core/isolation
rule core/secrets
rule core/locale
rule core/start
rule core/plan
rule core/ssot
rule core/composability

if os=linux,macos
    rule os/posix
if os=linux
    rule os/linux
if os=macos
    rule os/macos

if vcs=git
    rule vcs/git
if vcs=cvs
    rule vcs/cvs

rule collab/external
rule core/end

if role!=
    rule role/{role:}
    export role

if role=work,design,review
    rule core/architecture

if role=work,review
    rule core/testing

if role=work,law
    rule core/edit
    rule core/diff-review
