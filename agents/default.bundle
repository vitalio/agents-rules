# Description: Default project rules alias (core axioms, OS/VCS environment, base role posture, and role-gated editing/docs rules)
let lang=English
let chat_lang=the language the user writes in
let chat_date_fmt=DD/MM/YYYY

rule core/isolation
rule core/start
rule core/secrets
rule core/plan
rule core/ssot
rule core/composability
rule core/lang
rule core/end
rule collab/external

if os=linux
    rule os/linux
if os=macos
    rule os/macos

if vcs=git
    rule vcs/git
if vcs=cvs
    rule vcs/cvs

if role!=
    rule role/{role:}
    export role

if role=work,law
    rule core/edit
    rule core/diff-review

if role=work,design,review,law
    rule core/docs
