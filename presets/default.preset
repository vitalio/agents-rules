# Description: Default project rules (core workflow, external collaboration, and auto-detected OS and VCS)
rule core/start
rule core/secrets
rule core/plan
rule core/edit
rule core/diff-review
rule core/end
rule core/composability
rule core/lang lang=English
rule collab/external
[if os=linux] rule os/linux
[if os=macos] rule os/macos
[if os=windows] rule os/windows
[if vcs=git] rule vcs/git
[if vcs=cvs] rule vcs/cvs
