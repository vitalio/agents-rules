# Description: Zero-dependency Python CLI utility stack (workflow + OS + git + semver + cli + python-cli)
preset workflow lang=English
[if os=linux] rule os/linux
[if os=macos] rule os/macos
[if os=windows] rule os/windows
rule vcs/git
rule release/semver
rule stack/cli
rule stack/python-cli py_min=3.9
