bundle vitalio/agents-rules:core
bundle vitalio/agents-rules:adapters/todo_md
rule vitalio/agents-rules:collab/commits
bundle vitalio/agents-rules:release

file AGENTS.md
file agents/core/AGENTS.md
file agents/role/AGENTS.md
cmd context --tree
cmd git status -sb
cmd git branch -vv
cmd git log --oneline -10
